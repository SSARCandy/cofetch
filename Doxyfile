# API reference for the public header. Generate with: doxygen Doxyfile
# Output: docs/api/html/index.html
PROJECT_NAME           = cofetch
PROJECT_BRIEF          = "Chainable, high-performance async HTTP client for C++ event loops"
# The benchmark chart is copied next to the output post-run (see
# ci.yml): the README's <picture> is stripped down to its <img>, whose
# path is relative to the repo root, and the docs site needs the
# opaque variant so the chart stays readable in dark mode.
INPUT                  = include/cofetch.h \
                         README.md \
                         bench/README.md \
                         examples/README.md \
                         docs/examples.dox
# Absolute path: a bare "README.md" matches by basename and would drag
# bench/README.md and examples/README.md in as duplicate mainpages.
USE_MDFILE_AS_MAINPAGE = $(PWD)/README.md
EXAMPLE_PATH           = examples
OUTPUT_DIRECTORY       = docs/api
GENERATE_LATEX         = NO
EXTRACT_ALL            = YES
JAVADOC_AUTOBRIEF      = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = vendor/doxygen-awesome-css/doxygen-awesome.css
HTML_DYNAMIC_SECTIONS  = YES
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
